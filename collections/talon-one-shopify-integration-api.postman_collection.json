        {
          "id": "728b6649-24e6-45d4-9e2b-37afe235bc31",
          "name": "Retrieve customer data (Theme-based stores)",
          "request": {
            "name": "Retrieve customer data (Theme-based stores)",
            "description": {
              "content": "Fetches the Talon.One customer profile for a Shopify customer in a [theme-based store](https://shopify.dev/docs/storefronts/themes). The response is also stored in a customer metafield in Shopify. \n\nThe response schema is identical to the [List customer data](https://docs.talon.one/integration-api#tag/Customer-profiles/operation/getCustomerInventory) endpoint of the Integration API.\n\nIf you call this endpoint repeatedly with the same customer JWT token, the endpoint sends a cached response for the given customer. The cache clears after 10 seconds. This is done to reduce data load.        \n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "customer-profile"
              ],
              "host": [
                "{{baseUrl}}"
